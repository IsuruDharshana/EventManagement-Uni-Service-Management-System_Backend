{
  "info": {
    "name": "Event Service - LIVE integration (Group 5 + notifications)",
    "description": "Runs the real flow on the deployed services: real Group 5 logins and eligibility, event-service on Render, notifications to communication-feedback-service.\n\n1. Set the collection variable demoPassword (current value only; never save it or commit it).\n2. Run the folders in order. Tokens last 60 minutes.\n3. Notifications: event-service's Render log should have no 'was not delivered' line; Kasun can confirm the REGISTRATION_CONFIRMED / REGISTRATION_CANCELLED notifications for usr-student-001.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Fresh dates on every run: registration open now, event in 10 days.",
          "const iso = (d) => d.toISOString().slice(0, 19);",
          "const now = Date.now(), day = 86400000;",
          "pm.collectionVariables.set('registrationOpenAt', iso(new Date(now - day)));",
          "pm.collectionVariables.set('registrationCloseAt', iso(new Date(now + 9 * day)));",
          "pm.collectionVariables.set('scheduleStart', iso(new Date(now + 10 * day)));",
          "pm.collectionVariables.set('scheduleEnd', iso(new Date(now + 10 * day + 2 * 3600000)));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://eventmanagement-uni-service-management.onrender.com"
    },
    {
      "key": "identityUrl",
      "value": "https://university-identity-service.onrender.com"
    },
    {
      "key": "notificationUrl",
      "value": "https://notification-and-feedback-uni-service.onrender.com"
    },
    {
      "key": "demoPassword",
      "value": ""
    },
    {
      "key": "organizerToken",
      "value": ""
    },
    {
      "key": "studentToken",
      "value": ""
    },
    {
      "key": "academicToken",
      "value": ""
    },
    {
      "key": "eventId",
      "value": ""
    },
    {
      "key": "registrationId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Wake the services (can take ~1 minute each)",
      "item": [
        {
          "name": "Wake Group 5 Identity Service",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{identityUrl}}/health",
              "host": [
                "{{identityUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Wake event-service",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Wake notification service (Kasun)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{notificationUrl}}/actuator/health",
              "host": [
                "{{notificationUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Organizer creates and publishes an event",
      "item": [
        {
          "name": "Log in as EVO001",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{identityUrl}}/api/v1/auth/login",
              "host": [
                "{{identityUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Real Group 5 login. Set the collection variable demoPassword first (never save it in the file).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"EVO001\",\n  \"password\": \"{{demoPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login succeeded', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('organizerToken', pm.response.json().data.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create event open to STUDENT role",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{organizerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "events"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Live Integration Test Event\",\n  \"description\": \"Created by the live integration collection\",\n  \"online\": true,\n  \"scheduleStart\": \"{{scheduleStart}}\",\n  \"scheduleEnd\": \"{{scheduleEnd}}\",\n  \"capacity\": 10,\n  \"eligibilityRule\": \"{\\\"roles\\\": [\\\"STUDENT\\\"]}\",\n  \"registrationOpenAt\": \"{{registrationOpenAt}}\",\n  \"registrationCloseAt\": \"{{registrationCloseAt}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('organizer is EVO001 (usr-organizer-001)', () => pm.expect(b.organizerId).to.eql('usr-organizer-001'));",
                  "pm.collectionVariables.set('eventId', b.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Publish event",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{organizerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/{{eventId}}/publish",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "events",
                "{{eventId}}",
                "publish"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('PUBLISHED', () => pm.expect(pm.response.json().status).to.eql('PUBLISHED'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Real Group 5 eligibility",
      "item": [
        {
          "name": "Log in as STU001",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{identityUrl}}/api/v1/auth/login",
              "host": [
                "{{identityUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Real Group 5 login. Set the collection variable demoPassword first (never save it in the file).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"STU001\",\n  \"password\": \"{{demoPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login succeeded', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('studentToken', pm.response.json().data.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "STU001 (STUDENT) registers -> 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/{{eventId}}/registrations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "events",
                "{{eventId}}",
                "registrations"
              ]
            },
            "description": "Sends REGISTRATION_CONFIRMED to the notification service."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('CONFIRMED for usr-student-001', () => { pm.expect(b.status).to.eql('CONFIRMED'); pm.expect(b.userId).to.eql('usr-student-001'); });",
                  "pm.collectionVariables.set('registrationId', b.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in as ACD001",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{identityUrl}}/api/v1/auth/login",
              "host": [
                "{{identityUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Real Group 5 login. Set the collection variable demoPassword first (never save it in the file).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"ACD001\",\n  \"password\": \"{{demoPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login succeeded', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('academicToken', pm.response.json().data.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "ACD001 (ACADEMIC_STAFF) registers -> 403 NOT_ELIGIBLE",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{academicToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/{{eventId}}/registrations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "events",
                "{{eventId}}",
                "registrations"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 403', () => pm.response.to.have.status(403));",
                  "pm.test('NOT_ELIGIBLE (if this is 201, GROUP5_MOCK is still true on Render)', () => pm.expect(pm.response.json().error.code).to.eql('NOT_ELIGIBLE'));"
                ]
              }
            }
          ]
        },
        {
          "name": "STU001 registers again -> 409 ALREADY_REGISTERED",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/{{eventId}}/registrations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "events",
                "{{eventId}}",
                "registrations"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 409', () => pm.response.to.have.status(409));",
                  "pm.test('ALREADY_REGISTERED', () => pm.expect(pm.response.json().error.code).to.eql('ALREADY_REGISTERED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "No token -> 401",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/{{eventId}}/registrations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "events",
                "{{eventId}}",
                "registrations"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Cancel and clean up (sends more notifications)",
      "item": [
        {
          "name": "STU001 cancels registration",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/registrations/{{registrationId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "registrations",
                "{{registrationId}}",
                "cancel"
              ]
            },
            "description": "Sends REGISTRATION_CANCELLED to the notification service."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('CANCELLED', () => pm.expect(pm.response.json().status).to.eql('CANCELLED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "STU001 sees it in my registrations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/registrations/mine",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "registrations",
                "mine"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('listed as CANCELLED', () => pm.expect(pm.response.json().find(r => r.id === pm.collectionVariables.get('registrationId')).status).to.eql('CANCELLED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Organizer cancels the test event",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{organizerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/{{eventId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "events",
                "{{eventId}}",
                "cancel"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('CANCELLED', () => pm.expect(pm.response.json().status).to.eql('CANCELLED'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}