            "description" : "INVALID_PARAMETER (id is not a UUID), INVALID_STATE (only DRAFT events can be published) or VENUE_NOT_FOUND: Group 6 does not know the venue code"
          },
          "401" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description" : "UNAUTHORIZED"
          },
          "403" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description" : "FORBIDDEN: caller does not own the event"
          },
          "404" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description" : "NOT_FOUND"
          },
          "409" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description" : "VENUE_NOT_AVAILABLE: Group 6 says the venue cannot be used"
          },
          "500" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description" : "INTERNAL_ERROR: unexpected error, no internal details are returned"
          },
          "503" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description" : "GROUP6_UNAVAILABLE: venue service unreachable, event stays DRAFT"
          }
        },
        "summary" : "Publish a draft event",
        "tags" : [ "Events" ]
      }
    },
