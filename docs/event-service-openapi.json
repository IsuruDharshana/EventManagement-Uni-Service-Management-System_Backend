  "components" : {
    "schemas" : {
      "ApiErrorResponse" : {
        "type" : "object",
        "properties" : {
          "error" : {
            "$ref" : "#/components/schemas/ErrorDetail"
          },
          "success" : {
            "type" : "boolean",
            "example" : false
          }
        }
      },
      "CreateEventRequest" : {
        "type" : "object",
        "properties" : {
          "capacity" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "Must be greater than 0",
            "example" : 30
          },
          "description" : {
            "type" : "string",
            "example" : "Hands-on workshop for Computing students"
          },
          "eligibilityRule" : {
            "type" : "string",
            "description" : "JSON rule saying who may register. {\"all\": true} means everyone. Otherwise any of: roles (Group 5 role names, user needs one), departmentId / facultyId (Group 5 directory ids the user must belong to)",
            "example" : {
              "roles" : [ "STUDENT" ],
              "departmentId" : "dep-cs"
            },
            "minLength" : 1
          },
          "online" : {
            "type" : "boolean",
            "example" : false
          },
          "registrationCloseAt" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "Must be on or before scheduleStart",
            "example" : "2026-10-04T18:00:00"
          },
          "registrationOpenAt" : {
            "type" : "string",
            "format" : "date-time",
            "example" : "2026-09-25T08:00:00"
          },
          "scheduleEnd" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "Must be after scheduleStart",
            "example" : "2026-10-05T13:00:00"
          },
          "scheduleStart" : {
            "type" : "string",
            "format" : "date-time",
            "example" : "2026-10-05T10:00:00"
          },
          "title" : {
            "type" : "string",
            "example" : "Innovation Week Workshop",
            "maxLength" : 200,
            "minLength" : 0
          },
          "venue" : {
            "type" : "string",
            "description" : "Group 6 resource code of the venue. Checked with Group 6 when a physical event is published. Leave empty for online events",
            "example" : "LAB-101",
            "maxLength" : 200,
            "minLength" : 0
          }
        },
        "required" : [ "capacity", "eligibilityRule", "registrationCloseAt", "registrationOpenAt", "scheduleEnd", "scheduleStart", "title" ]
      },
      "ErrorDetail" : {
        "type" : "object",
        "properties" : {
          "code" : {
            "type" : "string",
            "example" : "CAPACITY_REACHED"
          },
          "message" : {
            "type" : "string",
            "example" : "This event has reached its registration capacity."
          }
        }
      },
      "EventRegistrationSummary" : {
        "type" : "object",
        "properties" : {
          "cancelled" : {
            "type" : "integer",
            "format" : "int64",
            "example" : 3
          },
          "capacity" : {
            "type" : "integer",
            "format" : "int32",
            "example" : 30
          },
          "confirmed" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Registrations that hold a seat",
            "example" : 12
          },
          "eventId" : {
            "type" : "string",
            "format" : "uuid",
            "example" : "a0000000-0000-0000-0000-000000000001"
          },
          "remainingSeats" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "capacity - confirmed, never below 0",
            "example" : 18
          },
          "status" : {
            "type" : "string",
            "enum" : [ "DRAFT", "PUBLISHED", "CANCELLED", "COMPLETED" ]
          },
          "title" : {
            "type" : "string",
            "example" : "Innovation Week Workshop"
          }
        }
      },
      "EventResponse" : {
        "type" : "object",
        "properties" : {
          "capacity" : {
            "type" : "integer",
            "format" : "int32",
            "example" : 30
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "description" : {
            "type" : "string",
            "example" : "Hands-on workshop for Computing students"
          },
          "eligibilityRule" : {
            "type" : "string",
            "description" : "JSON rule as a string, e.g. {\"all\": true} or {\"roles\": [\"STUDENT\"], \"departmentId\": \"dep-cs\"}",
            "example" : {
              "roles" : [ "STUDENT" ],
              "departmentId" : "dep-cs"
            }
          },
          "id" : {
            "type" : "string",
            "format" : "uuid",
            "example" : "a0000000-0000-0000-0000-000000000001"
          },
          "online" : {
            "type" : "boolean",
            "example" : false
          },
          "organizerId" : {
            "type" : "string",
            "description" : "Group 5 user id of the organizer",
            "example" : "usr-organizer-001"
          },
          "registrationCloseAt" : {
            "type" : "string",
            "format" : "date-time",
            "example" : "2026-10-04T18:00:00"
          },
          "registrationOpenAt" : {
            "type" : "string",
            "format" : "date-time",
            "example" : "2026-09-25T08:00:00"
          },
          "scheduleEnd" : {
            "type" : "string",
            "format" : "date-time",
            "example" : "2026-10-05T13:00:00"
          },
          "scheduleStart" : {
            "type" : "string",
            "format" : "date-time",
            "example" : "2026-10-05T10:00:00"
          },
          "status" : {
            "type" : "string",
            "description" : "DRAFT -> PUBLISHED -> COMPLETED, or CANCELLED from DRAFT/PUBLISHED",
            "enum" : [ "DRAFT", "PUBLISHED", "CANCELLED", "COMPLETED" ]
          },
          "title" : {
            "type" : "string",
            "example" : "Innovation Week Workshop"
          },
          "updatedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "venue" : {
            "type" : "string",
            "description" : "Group 6 resource code; null for online events",
            "example" : "LAB-101"
          }
        }
      },
      "EventsOverview" : {
        "type" : "object",
        "properties" : {
          "cancelled" : {
            "type" : "integer",
            "format" : "int64",
            "example" : 1
          },
          "cancelledRegistrations" : {
            "type" : "integer",
            "format" : "int64",
            "example" : 5
          },
          "completed" : {
            "type" : "integer",
            "format" : "int64",
            "example" : 2
          },
          "confirmedRegistrations" : {
            "type" : "integer",
            "format" : "int64",
            "example" : 40
          },
          "draft" : {
            "type" : "integer",
            "format" : "int64",
            "example" : 1
          },
          "published" : {
            "type" : "integer",
            "format" : "int64",
            "example" : 3
          },
          "totalEvents" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "draft + published + cancelled + completed",
            "example" : 7
          }
        }
      },
      "RegistrationResponse" : {
        "type" : "object",
        "properties" : {
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "eventId" : {
            "type" : "string",
            "format" : "uuid",
            "example" : "a0000000-0000-0000-0000-000000000001"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid",
            "example" : "b0000000-0000-0000-0000-000000000001"
          },
          "status" : {
            "type" : "string",
            "description" : "CONFIRMED counts toward capacity; CANCELLED by the user; WAITLISTED is reserved and not used yet",
            "enum" : [ "CONFIRMED", "CANCELLED", "WAITLISTED" ]
          },
          "updatedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "userId" : {
            "type" : "string",
            "description" : "Group 5 user id of the registered user",
            "example" : "usr-student-001"
          }
        }
      },
      "UpdateEventRequest" : {
        "type" : "object",
        "description" : "Partial update: send only the fields to change; missing or null fields stay as they are. Same rules as create (dates must fit together, eligibilityRule in the supported format).",
        "properties" : {
          "capacity" : {
            "type" : "integer",
            "format" : "int32"
          },
          "description" : {
            "type" : "string"
          },
          "eligibilityRule" : {
            "type" : "string"
          },
          "online" : {
            "type" : "boolean"
          },
          "registrationCloseAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "registrationOpenAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "scheduleEnd" : {
            "type" : "string",
            "format" : "date-time"
          },
          "scheduleStart" : {
            "type" : "string",
            "format" : "date-time"
          },
          "title" : {
            "type" : "string",
            "maxLength" : 200,
            "minLength" : 0
          },
          "venue" : {
            "type" : "string",
            "maxLength" : 200,
            "minLength" : 0
          }
        }
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "bearerFormat" : "JWT",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  }
}
